############################
# Python / environment
############################
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
env/

############################
# OS / editor / local tooling
############################
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.claude/settings.local.json
~$*

############################
# Large generated binaries
# D_lst (~555 MB each) is regenerated via src/runGeneratorOfD_v7.py
############################
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5

############################
# Diagnostics: keep REPORT.md, audit_dlst.py, logs/, results/
# Drop work/ (pkl files + duplicated data/src snapshots of hist45d9509)
############################
diagnostics/**/work/

############################
# Legacy: old inputs and outputs, kept only locally
############################
**/legacy/

############################
# Not public: copyrighted papers, rows of individual users
############################
/literature/
/data/D_lst_summary/samples/

############################
# Zip archives duplicating existing folders
############################
outputs/**/*.zip

############################
# Logs: root logs/ only; keep the final run log
############################
/logs/
*.log
!outputs/heldout_evaluation/*.log

############################
# LaTeX build artifacts
############################
*.aux
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz
*.xdv

############################
# Temp / misc
############################
*.tmp
*.cache
todo

