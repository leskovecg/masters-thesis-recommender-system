############################
# Python / environment
############################
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
env/

############################
# OS / editor / local tooling
############################
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.claude/settings.local.json
~$*

############################
# Large generated binaries
# D_lst (~555 MB each) is regenerated via src/runGeneratorOfD_v7.py
############################
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.h5

############################
# Local audit leftovers (pkl files, data snapshots); not in the repository
############################
/diagnostics

############################
# Legacy: old inputs and outputs, kept only locally
############################
**/legacy/

############################
# Not public: copyrighted papers, rows of individual users
############################
/literature/
/data/D_lst_summary/samples/
# Thesis PDF: published after the defense
/overleaf/2024_GLeskovec_MAG/main.pdf

############################
# Zip archives duplicating existing folders
############################
outputs/**/*.zip

############################
# Logs: root logs/ only; keep the final run log
############################
/logs/
*.log
!outputs/*.log

############################
# LaTeX build artifacts
############################
*.aux
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.toc
*.synctex.gz
*.xdv

############################
# Temp / misc
############################
*.tmp
*.cache
